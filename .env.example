# ─── Claude Authentication (one of these is required) ───────────────────────

# Claude subscription (Pro/Max) — get via `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic API key — from console.anthropic.com (alternative to OAuth)
# ANTHROPIC_API_KEY=


# ─── Core Settings ───────────────────────────────────────────────────────────

# Name the agent responds to (used as trigger word and in CLAUDE.md)
# Default: Andy
# ASSISTANT_NAME=Andy

# Set to true if the WhatsApp number is dedicated to the bot (not your personal number)
# Default: false (shared number)
# ASSISTANT_HAS_OWN_NUMBER=false

# Timezone for cron scheduling. Use IANA zone names.
# Default: system timezone
TZ=America/New_York

# Log level: trace | debug | info | warn | error
# Default: info
# LOG_LEVEL=info


# ─── Container Settings ──────────────────────────────────────────────────────

# Docker/Apple Container image name
# Default: nanoclaw-agent:latest
# CONTAINER_IMAGE=nanoclaw-agent:latest

# Max time a container can run before being killed (milliseconds)
# Default: 1800000 (30 minutes)
# CONTAINER_TIMEOUT=1800000

# Max container stdout size before truncation (bytes)
# Default: 10485760 (10 MB)
# CONTAINER_MAX_OUTPUT_SIZE=10485760

# How long to keep a container alive waiting for follow-up messages (milliseconds)
# Default: 1800000 (30 minutes)
# IDLE_TIMEOUT=1800000

# Max containers running simultaneously across all groups
# Default: 5
# MAX_CONCURRENT_CONTAINERS=5


# ─── X (Twitter) Integration ─────────────────────────────────────────────────

# Path to Chrome executable for Playwright browser automation
# Default: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome


# ─── Optional Channels (added via skills) ────────────────────────────────────

# Telegram bot token — from @BotFather (added via /add-telegram)
# TELEGRAM_BOT_TOKEN=

# Set to true to disable WhatsApp and use Telegram only
# TELEGRAM_ONLY=false

# Telegram bot pool JSON for agent swarm support (added via /add-telegram-swarm)
# TELEGRAM_BOT_POOL=

# Discord bot token (added via /add-discord)
# DISCORD_BOT_TOKEN=

# Set to true to use Discord as the only channel
# DISCORD_ONLY=false

# API key for parallel AI provider (added via /add-parallel)
# PARALLEL_API_KEY=
